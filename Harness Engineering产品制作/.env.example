# ============================================================
#  只需改下面这一行：填入你的 DeepSeek API Key
#  获取地址: https://platform.deepseek.com/
# ============================================================
ANTHROPIC_API_KEY=sk-在这里填你的key

# ============================================================
#  以下已为你配好 DeepSeek，一般无需修改
# ============================================================
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
MODEL_ID=deepseek-chat

# ============================================================
#  可选：换模型 / 换供应商（把对应行的 # 去掉即可）
# ============================================================
# DeepSeek 模型：
#   MODEL_ID=deepseek-chat       通用对话/编码（推荐，快）
#   MODEL_ID=deepseek-reasoner   深度推理（更慢，更贵）

# Claude 官方（key 形如 sk-ant-...）：
#   ANTHROPIC_BASE_URL=https://api.anthropic.com
#   MODEL_ID=claude-sonnet-4-6

# 其他 Anthropic 兼容供应商，以各自官方文档为准：
#   MiniMax  https://www.minimax.io
#   GLM      https://z.ai
#   Kimi     https://platform.kimi.ai
