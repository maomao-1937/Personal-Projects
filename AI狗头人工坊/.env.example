# Set these in your hosting platform, or export them in the shell before npm start.
PORT=8787
HOST=127.0.0.1
# Additional HTTPS provider domains, exact hostnames separated by commas.
# Official OpenAI / Gemini / DashScope / Ark / DeepSeek / Zhipu / MiniMax / Kimi hosts are enabled.
ALLOWED_API_HOSTS=
# Only set when you know the exact reverse-proxy hop count. Never use true.
TRUST_PROXY_HOPS=
# Provider keys are supplied in the UI and never saved in this file.

# Required to edit shared connections in production; never put the actual token in Git.
STUDIO_ADMIN_TOKEN=
# Persistent server directory; keep vault.key and connections.enc private and together.
STUDIO_DATA_DIR=.studio-data
# UTC daily shared generation reservation limit, single process; resets on restart.
STUDIO_DAILY_RENDER_LIMIT=100
# UTC daily shared DeepSeek prompt requests; single process, resets on restart.
STUDIO_DAILY_PROMPT_LIMIT=100
