      "html": "<button class=\"ds-button-ghost\">查看记录</button>",
      "css": ".ds-button-ghost{font-family:var(--font-sans, sans-serif);font-size:14px;font-weight:500;border-radius:8px;min-height:44px;padding:8px 16px;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:background-color 160ms,color 160ms;background:transparent;color:var(--foreground,#242622);border:0;}.ds-button-ghost:hover:not(:disabled){background:var(--accent-soft,#edf0fb);}.ds-button-ghost:focus-visible{outline:2px solid var(--focus,#3658c9);outline-offset:4px;}.ds-button-ghost:disabled{opacity:.5;cursor:not-allowed;}"
