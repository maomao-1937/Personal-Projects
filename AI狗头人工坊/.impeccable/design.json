    {
      "name": "模型设置输入",
      "kind": "input",
      "refersTo": "input",
      "description": "独立表单控件；实际基础圆角6px，手机16px字号。",
      "html": "<label class=\"ds-field\">模型名称<input class=\"ds-input\" placeholder=\"填写模型名称\" /></label>",
      "css": ".ds-field{display:grid;gap:8px;font-family:var(--font-sans,sans-serif);font-size:14px;color:var(--foreground,#242622);}.ds-input{min-height:44px;border:1px solid var(--control-border,#92958d);border-radius:6px;padding:4px 12px;background:var(--surface,#fff);color:var(--foreground,#242622);font:inherit;line-height:1.5;}.ds-input:focus-visible{outline:2px solid var(--focus,#3658c9);outline-offset:4px;}.ds-input:disabled{opacity:.5;cursor:not-allowed;}.ds-input[aria-invalid=true]{border-color:var(--error,#b42318);}@media(max-width:767px){.ds-input{font-size:16px;}}"
    },
    {
      "name": "顶栏工具导航",
      "kind": "nav",
      "description": "项目工作台的新建、历史、设置；移动端收起文字，保留可访问名称。",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><button aria-label=\"新建创作\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\" /></svg><span>新建</span></button><button aria-label=\"打开项目历史\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 2.6-6.4L3 8M3 3v5h5M12 7v5l3 2\" /></svg><span>历史</span></button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:4px;background:var(--surface,#fff);}.ds-nav button{font-family:var(--font-sans, sans-serif);font-size:14px;font-weight:500;border-radius:8px;min-height:44px;padding:8px 16px;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:background-color 160ms,color 160ms;padding:0 12px;border:0;background:transparent;color:var(--secondary-text,#62655e);}.ds-nav button:hover{background:var(--accent-soft,#edf0fb);color:var(--foreground,#242622);}.ds-nav button:focus-visible{outline:2px solid var(--focus,#3658c9);outline-offset:4px;}@media(max-width:767px){.ds-nav{gap:0;}.ds-nav button{width:40px;padding:0;}.ds-nav span{display:none;}}"
    },
    {
      "name": "创作模式选项",
      "kind": "chip",
      "refersTo": "mode-selected",
      "description": "实际双模式切换，不是装饰标签；此静态样式片段不执行应用状态切换。",
      "html": "<div class=\"ds-modes\" role=\"group\" aria-label=\"创作模式\"><button aria-pressed=\"true\">Agent 创作</button><button aria-pressed=\"false\">自己控制</button></div>",
      "css": ".ds-modes{display:flex;gap:2px;}.ds-modes button{font-family:var(--font-sans,sans-serif);font-size:13px;font-weight:500;min-height:40px;padding:8px 10px;border:0;border-radius:6px;cursor:pointer;background:transparent;color:var(--secondary-text,#62655e);}.ds-modes button[aria-pressed=true]{background:var(--muted,#eeefea);color:var(--foreground,#242622);}.ds-modes button:focus-visible{outline:2px solid var(--focus,#3658c9);outline-offset:4px;}"
    },
    {
      "name": "常驻创作输入容器",
