      "html": "<button class=\"ds-button-primary\">开始创作</button>",
      "css": ".ds-button-primary{font-family:var(--font-sans, sans-serif);font-size:14px;font-weight:500;border-radius:8px;min-height:44px;padding:8px 16px;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:background-color 160ms,color 160ms;background:var(--primary,#242622);color:var(--on-primary,#fff);border:0;}.ds-button-primary:hover:not(:disabled){background:var(--primary-hover,#3c4038);}.ds-button-primary:focus-visible{outline:2px solid var(--focus,#3658c9);outline-offset:4px;}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed;}"
    },
    {
      "name": "描边按钮",
