# 幻我 · AI 造像馆 — 环境变量示例
# 复制为 .env 并填入真实值

# 服务端口
PORT=8099

# 阿里万相 API 配置（OpenAI 兼容模式）
AI_API_KEY=sk-your-api-key-here
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=wanx-v1

# 单次 API 调用生成张数（wanx-v1 最大支持 4）
AI_BATCH_SIZE=4

# 邀请码列表（逗号分隔，大写）
INVITE_CODES=HUANWO2024,VIP888,TEST123
