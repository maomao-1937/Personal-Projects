APP_ENV=development
DATABASE_URL=sqlite:///./data/ai-interrogation.db
CORS_ORIGINS=http://localhost:3011,http://127.0.0.1:3011
# 只在 backend/.env 或部署平台的服务端秘密变量中填写。
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_CASE_MODEL=qwen3.6-plus
LLM_REVIEW_MODEL=qwen3.6-plus
LLM_DIALOGUE_MODEL=qwen-plus-character
LLM_TIMEOUT_SECONDS=90
LLM_TRUST_ENV=false

# 生产访问令牌只保存 SHA-256 哈希，不保存明文。
ACCESS_TOKEN_HASH=
AUTH_SIGNING_SECRET=
AUTH_SUBJECT=shared-access
AUTH_COOKIE_NAME=ai_interrogation_access
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=604800
AUTH_MAX_FAILURES=5
AUTH_FAILURE_WINDOW_SECONDS=900

# 生产环境使用 TOS 持久化 SQLite 快照。
TOS_BACKUP_ENABLED=false
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=
TOS_OBJECT_KEY=db-backup/ai-interrogation.db
TOS_BACKUP_INTERVAL_SECONDS=60
