# 本地默认使用 SQLite；生产环境改为 PostgreSQL。
DATABASE_URL=sqlite:///./incubator.db
# DATABASE_URL=postgresql+psycopg://incubator:password@localhost:5432/incubator

# 必填。个人 MVP 使用单用户 Bearer Token，服务端身份固定为 owner。
APP_API_TOKEN=replace-with-a-long-random-token

# 不配置密钥时使用确定性的本地启发式模型，适合演示与测试。
# ANTHROPIC_API_KEY=sk-ant-xxx
MODEL_ID=claude-sonnet-4-6

RETRIEVAL_LIMIT=12
