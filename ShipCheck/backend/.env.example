# ===== 混元 API (OpenAI 兼容接口) =====
# 验收前由 PM 填入真实 Key;开发期留空,MOCK_MODE=true 全部走 mock
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL=hunyuan-turbos-latest
HUNYUAN_VISION_MODEL=hunyuan-vision-latest

# ===== 应用 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== 数据 =====
DB_URL=sqlite:///./data/shipcheck.db
DATA_DIR=./data
SCREENSHOT_DIR=./data/screenshots

# ===== Agent 边界 =====
# 每 checklist item 最多浏览器动作步数
MAX_STEPS_PER_ITEM=15
# 单 item 超时(秒)
ITEM_TIMEOUT_SECONDS=60
# 整 Job 最大步数
MAX_TOTAL_STEPS=30
# 模型格式重试次数
LLM_MAX_RETRIES=2

# ===== Mock =====
# true 时跳过真实混元与浏览器,全部走 mock(开发/测试用)
MOCK_MODE=true
