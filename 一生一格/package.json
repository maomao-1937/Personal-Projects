{
  "name": "life-in-weeks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "test": "node --test src/lib/lifeCalendar.test.ts src/lib/taskPlan.test.ts src/lib/profileStorage.test.ts src/lib/accountDraft.test.ts server/app.test.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "invite": "node --env-file-if-exists=.env scripts/invite.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs --production",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.0.5"
  }
}
