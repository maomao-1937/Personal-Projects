# Application
MEETINGMEMO_APP_ENV=development
APP_NAME=meetingmemo-api
FRONTEND_ORIGIN=http://localhost:3000
SECRET_KEY=replace-with-at-least-32-random-characters
ALLOW_ORIGINLESS_STATE_CHANGES=true

# Persistence
DATABASE_URL=sqlite:///./data/meetingmemo.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=5242880
MAX_REQUEST_BYTES=6291456

# Invitation access
SESSION_DAYS=30
INVITE_RATE_LIMIT_ATTEMPTS=20
INVITE_RATE_LIMIT_WINDOW_SECONDS=60

# Persistent summary jobs
JOB_LEASE_SECONDS=900
JOB_HEARTBEAT_SECONDS=30
DELIVERY_PENDING_TIMEOUT_SECONDS=120

# LLM: keep mock locally; production values are filled before deployment
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-model-id

# Optional Slack delivery (official HTTPS webhook required in production)
SLACK_WEBHOOK_URL=

# Optional SMTP delivery (STARTTLS is mandatory in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
EMAIL_DEFAULT_TO=
SMTP_USE_TLS=true
