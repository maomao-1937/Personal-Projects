ENVIRONMENT=dev
DATABASE_URL=sqlite:///./data/app.db
STORAGE_PROVIDER=local
S3_AUTH_MODE=static
SQLITE_BACKUP_INTERVAL_SECONDS=300
SQLITE_BACKUP_MAX_AGE_SECONDS=600
SQLITE_ALLOW_BOOTSTRAP=false
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_OBJECT_PREFIX=conversation-qa
SESSION_SECRET=replace-with-at-least-32-random-characters
INVITE_CODE_PEPPER=replace-with-at-least-32-random-characters
INVITE_CODES=
INVITE_USAGE_LIMIT=50
ACCESS_TTL_SECONDS=43200
RESERVATION_TTL_SECONDS=180
MIN_TRANSCRIPT_CHARS=20
MAX_TRANSCRIPT_CHARS=12000
MAX_TURNS=200
METADATA_RETENTION_DAYS=90
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-seed-2-0-pro-260215
LLM_REASONING_EFFORT=minimal
LLM_MAX_TOKENS=3000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=2
ALLOWED_ORIGINS=http://localhost:3010
